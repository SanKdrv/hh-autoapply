# ── LLM для генерации сопроводительных писем ─────────────────────────────
# Любой OpenAI-совместимый провайдер. Для DeepSeek нужен ключ с
# https://platform.deepseek.com (вида sk-...).
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Telegram-бот для логов и уведомлений ─────────────────────────────────
# Создай бота у @BotFather, токен вставь сюда.
# chat_id узнай у @userinfobot или из getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Поведение ────────────────────────────────────────────────────────────
HH_APPLY_LIMIT=10
HH_LOG_LEVEL=info
